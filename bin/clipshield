#!/usr/bin/env bash
# clipshield — drive the plugin from outside Neovim: compositor keybinds
# (Hyprland), shell one-liners, scripts. The work is done by the plugin's own
# Lua (lua/clipshield/cli.lua) inside a headless, --clean Neovim; this script
# only feeds it the text and hands the result to the clipboard.
#
#   clipshield add [-n NAME] [-r REPLACEMENT]   add the current selection to the Watchlist
#   clipshield copy                             put the current selection on the clipboard, Masked
#   clipshield list                             Watchlist manager (wofi/rofi/fuzzel/bemenu +
#                                               zenity): view, edit the replacement, delete
#   clipshield tui                              the same manager as a terminal app
#
# Input: whatever is piped in; with none (a keybind has none) the Wayland
# primary selection — the text selected right now — then the clipboard.
#
# Suggested Hyprland binds (put into hyprland.conf yourself):
#   bind = SUPER SHIFT, C, exec, /path/to/Clipshield/bin/clipshield copy
#   bind = SUPER SHIFT, A, exec, /path/to/Clipshield/bin/clipshield add
#
# Needs wl-clipboard (wl-paste, wl-copy). notify-send is used for feedback
# when present; without it, messages go to stderr, where a terminal shows them.

set -euo pipefail

# Resolve through symlinks (e.g. ~/.local/bin/clipshield) to find the plugin.
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$script")/.." && pwd)"
cli=(nvim --headless --clean -u NONE --cmd "set rtp^=$root" -l "$root/lua/clipshield/cli.lua")

say() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 3000 clipshield "$*"
  else
    echo "clipshield: $*" >&2
  fi
}

input() {
  local text=""
  # A keybind process gets /dev/null or a closed stdin, not a tty — and that
  # counts as no input, so an empty read falls through to the selection.
  # Reading into a variable strips trailing newlines, which selections do not
  # want anyway.
  if [[ ! -t 0 ]]; then text="$(cat)"; fi
  if [[ -n "$text" ]]; then printf '%s' "$text"; return; fi
  command -v wl-paste >/dev/null 2>&1 || return 0
  # The selection first, the clipboard as a fallback; both empty is an error
  # the Lua side reports.
  wl-paste --primary 2>/dev/null || wl-paste 2>/dev/null || true
}

cmd="${1:-}"
case "$cmd" in
  add | copy | list | tui) shift ;;
  *)
    echo "usage: clipshield add [-n NAME] [-r REPLACEMENT] | clipshield copy | clipshield list | clipshield tui" >&2
    exit 64
    ;;
esac

case "$cmd" in
  add)
    # No data contract to keep — merge the status into one message.
    rc=0
    msg="$( { input | "${cli[@]}" add "$@"; } 2>&1 )" || rc=$?
    if [[ -n "$msg" ]]; then say "$msg"; fi
    exit "$rc"
    ;;
  copy)
    command -v wl-copy >/dev/null 2>&1 || {
      echo "clipshield: wl-copy is not installed" >&2
      exit 2
    }
    status="$(mktemp)"
    # A refused copy must not kill the script before its message is shown.
    rc=0
    input | "${cli[@]}" copy 2>"$status" | wl-copy || rc=$?
    msg="$(cat "$status")"
    rm -f "$status"
    if [[ -n "$msg" ]]; then say "$msg"; fi
    exit "$rc"
    ;;
  list)
    picker=()
    if [[ -n "${CLIPSHIELD_PICKER:-}" ]]; then
      # shellcheck disable=SC2206
      picker=(${CLIPSHIELD_PICKER})
    elif command -v wofi >/dev/null 2>&1; then
      picker=(wofi --dmenu -i -p clipshield)
    elif command -v rofi >/dev/null 2>&1; then
      picker=(rofi -dmenu -i -p clipshield)
    elif command -v fuzzel >/dev/null 2>&1; then
      picker=(fuzzel --dmenu)
    elif command -v bemenu >/dev/null 2>&1; then
      picker=(bemenu -p clipshield)
    else
      echo "clipshield: no dmenu-style picker found (wofi, rofi, fuzzel, bemenu)" >&2
      exit 2
    fi

    # A manager, not a one-shot: pick an entry, act on it, re-show the list.
    # stdin is pinned to /dev/null: the compositor's exec passes its own tty,
    # which never EOFs and would hang the reader.
    wl_list() { "${cli[@]}" list </dev/null 2>/dev/null; }
    while true; do
      lines=""; menu=""; choice=""; idx=""; name=""; repl=""; shown=""; act=""; msg=""; line=""
      lines="$(wl_list)"
      if [[ -z "$lines" ]]; then
        say "the Watchlist is empty"
        break
      fi
      # The hint bar lives at the top of the menu: dmenu has no status line,
      # so the first rows ARE the key legend.
      menu="clipshield · Enter: edit · Esc: close"
      menu+=$'\n'"──────────────────────────────"
      while IFS=$'\t' read -r idx name repl; do
        if [[ -n "$repl" ]]; then shown="$name → $repl"; else shown="$name  ·  numbered"; fi
        menu+=$'\n'"$idx  $shown"
      done <<< "$lines"
      choice="$(printf '%s\n' "$menu" | "${picker[@]}")" || true
      [[ -z "$choice" ]] && break                          # Esc
      [[ "$choice" =~ ^([0-9]+)[[:space:]] ]] || continue  # a hint row picked
      idx="${BASH_REMATCH[1]}"
      line="$(wl_list | awk -F '\t' -v i="$idx" '$1 == i')"
      [[ -z "$line" ]] && continue
      IFS=$'\t' read -r _ name repl <<< "$line"

      act="$(printf '%s\n' \
        "edit: $name · Enter: apply · Esc: back" \
        "──────────────────────────────" \
        "✎  Edit replacement…" \
        "↺  Use the numbered default" \
        "✖  Delete entry" | "${picker[@]}")" || true
      [[ -z "$act" ]] && continue                         # Esc — back to the list
      msg=""
      case "$act" in
        "✎"*)
          if ! command -v zenity >/dev/null 2>&1; then
            say "clipshield: zenity is needed to type a replacement"
            continue
          fi
          ans="$(zenity --entry --title clipshield \
            --text "What should ‘$name’ read as when copied?" \
            --entry-text "$repl" 2>/dev/null)" || continue
          msg="$("${cli[@]}" set "$idx" "$ans" </dev/null 2>&1)" || true
          ;;
        "↺"*) msg="$("${cli[@]}" set "$idx" "" </dev/null 2>&1)" || true ;;
        "✖"*) msg="$("${cli[@]}" remove "$idx" </dev/null 2>&1)" || true ;;
        *) continue ;;   # hint or separator picked
      esac
      if [[ -n "$msg" ]]; then say "$msg"; fi
    done
    ;;
  tui)
    # The manager as a terminal app: same engine, floating window in a --clean
    # nvim. exec replaces this shell — nothing runs after it.
    CLIPSHIELD_STANDALONE=1 exec nvim --clean -u NONE \
      --cmd "set rtp^=$root" \
      "+lua require('clipshield.tui').run()"
    ;;
esac
